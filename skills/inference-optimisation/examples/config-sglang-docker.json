{
  "name": "ctl-a",
  "base_url": "http://127.0.0.1:8000",
  "model": "my-model",
  "launch": ["docker", "run", "-d", "--name", "llm", "--device", "/dev/dri", "--shm-size", "2g",
             "-p", "127.0.0.1:8000:8000",
             "-v", "/path/to/weights:/models:ro",
             "-v", "/path/to/persistent-cache:/root/.cache",
             "my-engine-image@sha256:...",
             "python3", "-m", "sglang.launch_server", "--model-path", "/models", "--served-model-name", "my-model",
             "--host", "0.0.0.0", "--port", "8000", "--context-length", "262144",
             "--max-running-requests", "4", "--chunked-prefill-size", "4096",
             "--speculative-algorithm", "NEXTN", "--speculative-num-steps", "1",
             "--speculative-eagle-topk", "1", "--speculative-num-draft-tokens", "2"],
  "stop": ["bash", "-c", "curl -s -X POST localhost:8000/abort_request -d '{\"abort_all\":true}' -H 'Content-Type: application/json'; sleep 5; docker stop -t 60 llm; docker rm -f llm"],
  "health_timeout_s": 900,
  "concurrency": 4,
  "prefill_lengths": [4096, 32768],
  "extra_body": {"chat_template_kwargs": {"enable_thinking": false}},
  "temperature": 0.6,
  "memory": {"cap_gib": 46, "probe": ["sudo", "-n", "bash", "scripts/mem.sh", "llm", "unified"], "interval_s": 3},
  "require_ac": true
}
