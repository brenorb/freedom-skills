#!/bin/sh
# Turn on once per clone:   git config core.hooksPath .githooks
#
# 1. Requires metadata in each changed SKILL.md, reading the staged Git snapshot.
# 2. Validates every skill the commit touches (scripts/validate_skills_ref.sh).
# 3. Keeps the website and README in step with skills/: when the commit touches skills/,
#    site/, connectors/ or README.md, it regenerates the site data, the README skill tables and live
#    pages, stages exactly the files it rewrote, and checks every link points at something
#    that exists. Validation failures stop the commit and explain what needs fixing.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
  exit 0
fi

uv run --quiet --with pyyaml python scripts/check_skill_metadata.py --staged
"$repo_root/scripts/validate_skills_ref.sh" $staged_files

# --- website and README ---
[ -f scripts/build_site_data.py ] || exit 0
git diff --cached --quiet -- skills connectors site README.md && exit 0

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv is not installed, so the website wasn't regenerated." >&2
  echo "            Run: uv run --with pyyaml python scripts/build_site_data.py" >&2
  exit 0
fi

out=$(uv run --quiet --with pyyaml python scripts/build_site_data.py) || {
  echo "pre-commit: the website could not be regenerated (see above). Commit stopped." >&2
  exit 1
}
written=$(printf '%s\n' "$out" | sed -n 's/^wrote //p')
if [ -n "$written" ]; then
  printf '%s\n' "$written" | while IFS= read -r f; do git add -- "$f"; done
  echo "pre-commit: regenerated and staged:"
  printf '%s\n' "$written" | sed 's/^/  /'
fi

python3 scripts/check_site_links.py >/dev/null 2>&1 || {
  python3 scripts/check_site_links.py || true
  echo "pre-commit: fix the links above, or commit with --no-verify to skip." >&2
  exit 1
}
